# Copy to .env and fill in real values. Never commit .env.

# URL-encode special characters in the password (@ → %40, # → %23).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/astroarrox?schema=public"

# Only read by the seed, and only while no super admin exists.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-to-something-long"

# Used for SEO links, the sitemap and Open Graph.
SITE_URL="http://localhost:3000"

# Reverse proxies in front of the app. With 0, clients can fake their IP and dodge rate limits; use 0 only locally.
TRUSTED_PROXY_HOPS=1
